{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/professional-growth-coach/career-learning-decision-v3.schema.json",
  "title": "Career Learning Decision v3",
  "type": "object",
  "required": [
    "schema_version", "locale", "as_of_date", "state",
    "source_research_snapshot", "source_dossier_snapshot", "source_alignment_snapshot",
    "source_market_snapshot", "source_provider_research_snapshot",
    "source_gap_response_snapshot", "source_gap_assessment_snapshot",
    "source_next_action_eligibility_snapshot", "decisions", "privacy_boundary",
    "no_external_action", "outcome_boundary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "career-learning-decision-v3"},
    "locale": {"enum": ["es", "en"]},
    "as_of_date": {"type": "string", "format": "date"},
    "state": {"enum": ["complete", "limited", "unavailable"]},
    "source_research_snapshot": {"type": "string", "pattern": "^snap-market-sha256-[0-9a-f]{64}$"},
    "source_dossier_snapshot": {"type": "string", "pattern": "^snap-dossier-sha256-[0-9a-f]{64}$"},
    "source_alignment_snapshot": {"type": "string", "pattern": "^snap-alignment-sha256-[0-9a-f]{64}$"},
    "source_market_snapshot": {"type": "string", "pattern": "^snap-market-dossier-v2-sha256-[0-9a-f]{64}$"},
    "source_provider_research_snapshot": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^snap-provider-sha256-[0-9a-f]{64}$"}
      ]
    },
    "source_gap_response_snapshot": {"type": "string", "pattern": "^snap-gap-response-v1-sha256-[0-9a-f]{64}$"},
    "source_gap_assessment_snapshot": {"type": "string", "pattern": "^snap-gap-assessment-v1-sha256-[0-9a-f]{64}$"},
    "source_next_action_eligibility_snapshot": {"type": "string", "pattern": "^snap-next-action-eligibility-v1-sha256-[0-9a-f]{64}$"},
    "decisions": {"type": "array", "maxItems": 1, "items": {"$ref": "#/$defs/decision"}},
    "privacy_boundary": {"const": "identity_free_structured_provenance_only"},
    "no_external_action": {"const": true},
    "outcome_boundary": {"const": "not_an_interview_offer_salary_or_roi_prediction"}
  },
  "oneOf": [
    {"properties": {"state": {"enum": ["complete", "limited"]}, "decisions": {"maxItems": 1}}},
    {"properties": {"state": {"const": "unavailable"}, "decisions": {"maxItems": 0}}}
  ],
  "$defs": {
    "signal": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 500},
    "claim_ids": {"type": "array", "maxItems": 150, "uniqueItems": true, "items": {"type": "string", "pattern": "^C-[0-9]{3}$"}},
    "evidence_ids": {"type": "array", "maxItems": 150, "uniqueItems": true, "items": {"type": "string", "pattern": "^E-[0-9]{3}$"}},
    "requirement_ids": {"type": "array", "minItems": 2, "maxItems": 150, "uniqueItems": true, "items": {"type": "string", "pattern": "^V-[0-9]{3}-R-[0-9]{2}$"}},
    "vacancy_ids": {"type": "array", "minItems": 2, "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "pattern": "^V-[0-9]{3}$"}},
    "signal_route": {
      "type": "object",
      "required": ["signal", "term_label", "support_state", "recurrence", "vacancy_ordinals"],
      "additionalProperties": false,
      "properties": {
        "signal": {"$ref": "#/$defs/signal"},
        "term_label": {"type": "string", "minLength": 1, "maxLength": 80},
        "support_state": {"enum": ["verified_match", "candidate_reported_match", "unknown"]},
        "recurrence": {"type": "string", "pattern": "^[2-5]/[1-5]$"},
        "vacancy_ordinals": {"type": "array", "minItems": 2, "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "pattern": "^V[1-5]$"}}
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "decision_rank", "decision_code", "source_signals", "provider_option_id",
        "claim_ids", "source_evidence_ids", "requirement_ids", "vacancy_ids",
        "target_role_families", "gap_type", "option_type", "decision", "option_name",
        "provider_or_owner", "signal_routes", "cost_time_band", "expected_signal_boundary",
        "portfolio_or_no_learning_alternative", "overbuying_risk", "decision_basis",
        "next_action_gate", "outcome_boundary", "draft_only", "no_external_action"
      ],
      "additionalProperties": false,
      "properties": {
        "decision_rank": {"const": 1},
        "decision_code": {"enum": ["build_bounded_proof", "run_validation_lab", "research_provider_option", "run_role_search_experiment"]},
        "source_signals": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/signal"}},
        "provider_option_id": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^LP-[0-9]{3}$"}]},
        "claim_ids": {"$ref": "#/$defs/claim_ids"},
        "source_evidence_ids": {"$ref": "#/$defs/evidence_ids"},
        "requirement_ids": {"$ref": "#/$defs/requirement_ids"},
        "vacancy_ids": {"$ref": "#/$defs/vacancy_ids"},
        "target_role_families": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["site_reliability_engineering", "platform_engineering", "devops_engineering"]}},
        "gap_type": {"enum": ["knowledge", "proof", "practice", "terminology"]},
        "option_type": {"enum": ["course", "certification", "portfolio_project", "lab", "role_search"]},
        "decision": {"enum": ["do_now", "research_first"]},
        "option_name": {"$ref": "#/$defs/text"},
        "provider_or_owner": {"$ref": "#/$defs/text"},
        "signal_routes": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/signal_route"}},
        "cost_time_band": {"$ref": "#/$defs/text"},
        "expected_signal_boundary": {"$ref": "#/$defs/text"},
        "portfolio_or_no_learning_alternative": {"$ref": "#/$defs/text"},
        "overbuying_risk": {"$ref": "#/$defs/text"},
        "decision_basis": {"$ref": "#/$defs/text"},
        "next_action_gate": {"$ref": "#/$defs/text"},
        "outcome_boundary": {"const": "not_an_interview_offer_salary_or_roi_prediction"},
        "draft_only": {"const": true},
        "no_external_action": {"const": true}
      },
      "allOf": [
        {
          "if": {"properties": {"decision_code": {"const": "build_bounded_proof"}}, "required": ["decision_code"]},
          "then": {"properties": {"gap_type": {"const": "proof"}, "option_type": {"const": "portfolio_project"}, "decision": {"const": "do_now"}, "provider_option_id": {"type": "null"}, "provider_or_owner": {"const": "candidate_owned"}}}
        },
        {
          "if": {"properties": {"decision_code": {"const": "run_validation_lab"}}, "required": ["decision_code"]},
          "then": {"properties": {"gap_type": {"const": "practice"}, "option_type": {"const": "lab"}, "decision": {"const": "do_now"}, "provider_option_id": {"type": "null"}, "provider_or_owner": {"const": "candidate_owned"}}}
        },
        {
          "if": {"properties": {"decision_code": {"const": "research_provider_option"}}, "required": ["decision_code"]},
          "then": {"properties": {"gap_type": {"const": "knowledge"}, "option_type": {"enum": ["course", "certification"]}, "decision": {"const": "research_first"}, "provider_option_id": {"type": "string", "pattern": "^LP-[0-9]{3}$"}}}
        },
        {
          "if": {"properties": {"decision_code": {"const": "run_role_search_experiment"}}, "required": ["decision_code"]},
          "then": {"properties": {"gap_type": {"const": "terminology"}, "option_type": {"const": "role_search"}, "decision": {"const": "research_first"}, "provider_option_id": {"type": "null"}, "provider_or_owner": {"const": "candidate_owned"}}}
        }
      ]
    }
  }
}
