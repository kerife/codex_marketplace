{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/professional-growth-coach/private-first-interview-conversion-board-v1.schema.json",
  "title": "Private First-Interview Conversion Board v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "locale", "as_of_date", "source_group",
    "decision", "sequence", "proof_cards", "risk_checks", "rehearsal", "week",
    "decision_ladder", "daily_reviews", "approval_boundary", "delivery"
  ],
  "properties": {
    "schema_version": {"const": "private-first-interview-conversion-board-v1"},
    "artifact_kind": {"const": "private_first_interview_conversion_board"},
    "locale": {"enum": ["es", "en"]},
    "as_of_date": {"$ref": "#/$defs/date"},
    "source_group": {"$ref": "#/$defs/source_group"},
    "decision": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/decision"}},
    "sequence": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/sequence_stage"}},
    "proof_cards": {"type": "array", "minItems": 0, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/proof_card"}},
    "risk_checks": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/risk_check"}},
    "rehearsal": {"$ref": "#/$defs/rehearsal"},
    "week": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/week_day"}},
    "decision_ladder": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/decision_branch"}},
    "daily_reviews": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/daily_review"}},
    "approval_boundary": {"$ref": "#/$defs/approval_boundary"},
    "delivery": {"$ref": "#/$defs/delivery"}
  },
  "$defs": {
    "bounded_text": {"type": "string", "minLength": 1, "maxLength": 500},
    "short_text": {"type": "string", "minLength": 1, "maxLength": 160},
    "date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "day": {"type": "integer", "minimum": 1, "maximum": 7},
    "source_id": {"type": "string", "pattern": "^src-[a-z][a-z0-9-]{2,63}$"},
    "snapshot": {"type": "string", "pattern": "^snap-private-first-interview-v1-sha256-[0-9a-f]{64}$"},
    "source_group": {
      "type": "object", "additionalProperties": false,
      "required": ["group_id", "source_snapshot", "recruiter_outreach_lab", "quality_gate", "first_interview_7_day_plan", "weekly_coach_plan", "decision_ladder", "plan_days", "daily_review_logs"],
      "properties": {
        "group_id": {"type": "string", "pattern": "^group-synthetic-[a-z0-9-]{3,63}$"},
        "source_snapshot": {"$ref": "#/$defs/snapshot"},
        "recruiter_outreach_lab": {"$ref": "#/$defs/source_record"},
        "quality_gate": {
          "type": "object", "additionalProperties": false,
          "required": ["record_id", "state", "checks"],
          "properties": {
            "record_id": {"$ref": "#/$defs/source_id"},
            "state": {"enum": ["pass", "clarify", "pause", "stop"]},
            "checks": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/quality_check"}}
          }
        },
        "first_interview_7_day_plan": {"$ref": "#/$defs/source_record"},
        "weekly_coach_plan": {"$ref": "#/$defs/source_record"},
        "decision_ladder": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/source_ladder_row"}},
        "plan_days": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/source_day_row"}},
        "daily_review_logs": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/source_review_row"}}
      }
    },
    "source_record": {
      "type": "object", "additionalProperties": false,
      "required": ["record_id", "state", "objective", "fact_summary"],
      "properties": {
        "record_id": {"$ref": "#/$defs/source_id"},
        "state": {"enum": ["ready", "clarify", "pause", "stop"]},
        "objective": {"$ref": "#/$defs/short_text"},
        "fact_summary": {"$ref": "#/$defs/short_text"}
      }
    },
    "quality_check": {
      "type": "object", "additionalProperties": false,
      "required": ["check_id", "topic", "state"],
      "properties": {
        "check_id": {"$ref": "#/$defs/source_id"},
        "topic": {"enum": ["specificity", "evidence", "boundary"]},
        "state": {"enum": ["pass", "clarify", "stop"]}
      }
    },
    "source_ladder_row": {
      "type": "object", "additionalProperties": false,
      "required": ["branch", "trigger", "evidence"],
      "properties": {
        "branch": {"enum": ["advance", "clarify", "pause", "stop"]},
        "trigger": {"$ref": "#/$defs/short_text"},
        "evidence": {"$ref": "#/$defs/short_text"}
      }
    },
    "source_day_row": {
      "type": "object", "additionalProperties": false,
      "required": ["day", "action", "signal"],
      "properties": {
        "day": {"$ref": "#/$defs/day"},
        "action": {"$ref": "#/$defs/short_text"},
        "signal": {"$ref": "#/$defs/short_text"}
      }
    },
    "source_review_row": {
      "type": "object", "additionalProperties": false,
      "required": ["day", "observed_signal", "question"],
      "properties": {
        "day": {"$ref": "#/$defs/day"},
        "observed_signal": {"$ref": "#/$defs/short_text"},
        "question": {"$ref": "#/$defs/short_text"}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "objective", "current_state", "next_safe_action", "signal", "boundary"],
      "properties": {
        "state": {"enum": ["ready", "clarify", "pause", "stop"]},
        "objective": {"$ref": "#/$defs/bounded_text"},
        "current_state": {"$ref": "#/$defs/bounded_text"},
        "next_safe_action": {"$ref": "#/$defs/bounded_text"},
        "signal": {"$ref": "#/$defs/bounded_text"},
        "boundary": {"$ref": "#/$defs/bounded_text"}
      }
    },
    "sequence_stage": {
      "type": "object", "additionalProperties": false,
      "required": ["stage", "label", "description"],
      "properties": {
        "stage": {"enum": ["current_state", "private_preparation", "human_review", "authorization_gate"]},
        "label": {"$ref": "#/$defs/short_text"},
        "description": {"$ref": "#/$defs/bounded_text"}
      }
    },
    "proof_card": {
      "type": "object", "additionalProperties": false,
      "required": ["vacancy_signal", "evidence_summary", "caveat"],
      "properties": {"vacancy_signal": {"$ref": "#/$defs/short_text"}, "evidence_summary": {"$ref": "#/$defs/bounded_text"}, "caveat": {"$ref": "#/$defs/bounded_text"}}
    },
    "risk_check": {
      "type": "object", "additionalProperties": false,
      "required": ["topic", "trigger_question", "safe_response_boundary", "confirmation_needed", "forbidden_claim"],
      "properties": {
        "topic": {"enum": ["production", "compensation", "eligibility", "availability", "confidentiality"]},
        "trigger_question": {"$ref": "#/$defs/bounded_text"},
        "safe_response_boundary": {"$ref": "#/$defs/bounded_text"},
        "confirmation_needed": {"$ref": "#/$defs/bounded_text"},
        "forbidden_claim": {"$ref": "#/$defs/bounded_text"}
      }
    },
    "rehearsal": {
      "type": "object", "additionalProperties": false,
      "required": ["question", "purpose", "response_structure", "wait_boundary", "pre_response_score"],
      "properties": {
        "question": {"$ref": "#/$defs/bounded_text"}, "purpose": {"$ref": "#/$defs/bounded_text"}, "response_structure": {"$ref": "#/$defs/bounded_text"}, "wait_boundary": {"$ref": "#/$defs/bounded_text"}, "pre_response_score": {"const": "unknown"}
      }
    },
    "week_day": {
      "type": "object", "additionalProperties": false,
      "required": ["day", "private_action", "evidence_boundary", "review_checkpoint", "observable_signal", "fallback", "stop_rule"],
      "properties": {
        "day": {"$ref": "#/$defs/day"}, "private_action": {"$ref": "#/$defs/bounded_text"}, "evidence_boundary": {"$ref": "#/$defs/bounded_text"}, "review_checkpoint": {"$ref": "#/$defs/bounded_text"}, "observable_signal": {"$ref": "#/$defs/bounded_text"}, "fallback": {"$ref": "#/$defs/bounded_text"}, "stop_rule": {"$ref": "#/$defs/bounded_text"}
      }
    },
    "decision_branch": {
      "type": "object", "additionalProperties": false,
      "required": ["branch", "trigger", "evidence_requirement", "next_safe_action", "blocked_action", "measurement_label", "review_question", "script_boundary"],
      "properties": {
        "branch": {"enum": ["advance", "clarify", "pause", "stop"]}, "trigger": {"$ref": "#/$defs/bounded_text"}, "evidence_requirement": {"$ref": "#/$defs/bounded_text"}, "next_safe_action": {"$ref": "#/$defs/bounded_text"}, "blocked_action": {"$ref": "#/$defs/bounded_text"}, "measurement_label": {"$ref": "#/$defs/short_text"}, "review_question": {"$ref": "#/$defs/bounded_text"}, "script_boundary": {"$ref": "#/$defs/bounded_text"}
      }
    },
    "daily_review": {
      "type": "object", "additionalProperties": false,
      "required": ["day", "observed_signal", "signal_quality", "decision", "evidence_log", "next_safe_action", "metric_label", "confounder_note", "coach_question"],
      "properties": {
        "day": {"$ref": "#/$defs/day"}, "observed_signal": {"$ref": "#/$defs/bounded_text"}, "signal_quality": {"enum": ["strong", "mixed", "weak", "unknown"]}, "decision": {"enum": ["advance", "clarify", "pause", "stop"]}, "evidence_log": {"$ref": "#/$defs/bounded_text"}, "next_safe_action": {"$ref": "#/$defs/bounded_text"}, "metric_label": {"$ref": "#/$defs/short_text"}, "confounder_note": {"$ref": "#/$defs/bounded_text"}, "coach_question": {"$ref": "#/$defs/bounded_text"}
      }
    },
    "approval_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_state", "allowed_next_step", "prohibited_actions", "authorization_required"],
      "properties": {
        "artifact_state": {"const": "private_draft"}, "allowed_next_step": {"const": "manual_private_review"}, "prohibited_actions": {"type": "array", "minItems": 13, "maxItems": 13, "uniqueItems": true, "items": {"enum": ["message", "connect", "apply", "schedule", "calendar_create", "publish", "share", "upload", "submit", "export", "external_edit", "purchase", "enroll"]}}, "authorization_required": {"const": true}
      }
    },
    "delivery": {
      "type": "object", "additionalProperties": false,
      "required": ["draft_only", "external_actions_authorized", "no_message_action", "no_calendar_action", "raw_event_retained", "raw_reply_retained", "raw_answer_retained", "local_save_mode", "candidate_review_required"],
      "properties": {
        "draft_only": {"const": true}, "external_actions_authorized": {"const": false}, "no_message_action": {"const": true}, "no_calendar_action": {"const": true}, "raw_event_retained": {"const": false}, "raw_reply_retained": {"const": false}, "raw_answer_retained": {"const": false}, "local_save_mode": {"const": "disabled"}, "candidate_review_required": {"const": true}
      }
    }
  }
}
