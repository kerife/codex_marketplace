{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/professional-growth-coach/private-first-interview-practice-feedback-v1.schema.json",
  "title": "Private First-Interview Practice Feedback v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["feedback_version", "feedback_kind", "session", "proof_binding"],
  "properties": {
    "feedback_version": {"const": "private-first-interview-practice-feedback-v1"},
    "feedback_kind": {"const": "private_first_interview_practice_feedback"},
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "state", "observed_answer", "feedback", "delivery", "handoff_context"],
      "properties": {
        "schema_version": {"const": "recruiter-practice-session-v2"},
        "session_kind": {"const": "private_recruiter_practice"},
        "ui_locale": {"enum": ["es", "en"]},
        "content_locale": {"enum": ["es", "en"]},
        "state": {"const": "feedback_available"},
        "safe_context": {"type": "object"},
        "requirement": {"type": "object"},
        "question": {"type": "object"},
        "facts": {"type": "array"},
        "observed_answer": {"type": "object"},
        "rubric": {"type": "object"},
        "feedback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["score", "score_state", "observations"],
          "properties": {
            "score": {"const": "unknown"},
            "score_state": {"const": "categorical"},
            "observations": {"type": "array", "minItems": 1, "maxItems": 1}
          }
        },
        "delivery": {"type": "object"},
        "handoff_context": {"type": "object"}
      }
    },
    "proof_binding": {"type": "string", "pattern": "^snap-practice-board-sha256-[0-9a-f]{64}$"}
  }
}
