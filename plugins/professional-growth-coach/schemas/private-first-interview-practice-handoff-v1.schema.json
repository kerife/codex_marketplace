{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/professional-growth-coach/private-first-interview-practice-handoff-v1.schema.json",
  "title": "Private First-Interview Practice Handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["handoff_version", "handoff_kind", "session", "proof_binding"],
  "properties": {
    "handoff_version": {"const": "private-first-interview-practice-handoff-v1"},
    "handoff_kind": {"const": "private_first_interview_practice_handoff"},
    "session": {"$ref": "#/$defs/session"},
    "proof_binding": {"type": "string", "pattern": "^snap-practice-board-sha256-[0-9a-f]{64}$"}
  },
  "$defs": {
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "session_kind", "ui_locale", "content_locale", "state", "safe_context", "requirement", "question", "facts", "observed_answer", "rubric", "feedback", "delivery", "handoff_context"],
      "properties": {
        "schema_version": {"const": "recruiter-practice-session-v2"},
        "session_kind": {"const": "private_recruiter_practice"},
        "ui_locale": {"enum": ["es", "en"]},
        "content_locale": {"enum": ["es", "en"]},
        "state": {"const": "awaiting_answer"},
        "safe_context": {"type": "object"},
        "requirement": {"type": "object"},
        "question": {"type": "object"},
        "facts": {"type": "array", "minItems": 1, "maxItems": 1},
        "observed_answer": {"const": null},
        "rubric": {"type": "object"},
        "feedback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["score", "score_state", "observations"],
          "properties": {
            "score": {"const": "unknown"},
            "score_state": {"const": "unknown"},
            "observations": {"type": "array", "maxItems": 0}
          }
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["draft_only", "external_actions_authorized", "local_save_mode", "raw_answer_retained"],
          "properties": {
            "draft_only": {"const": true},
            "external_actions_authorized": {"const": false},
            "local_save_mode": {"const": "disabled"},
            "raw_answer_retained": {"const": false}
          }
        },
        "handoff_context": {"$ref": "#/$defs/handoff_context"}
      }
    },
    "handoff_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "source_snapshot", "question_rank", "question_id", "requirement_id", "fact_ids", "draft_only", "external_actions_authorized"],
      "properties": {
        "source": {"const": "private_first_interview_conversion_board"},
        "source_snapshot": {"type": "string", "pattern": "^snap-practice-board-sha256-[0-9a-f]{64}$"},
        "question_rank": {"const": 1},
        "question_id": {"pattern": "^Q-[0-9]{3}$"},
        "requirement_id": {"pattern": "^R-[0-9]{3}$"},
        "fact_ids": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"pattern": "^F-[0-9]{3}$"}},
        "draft_only": {"const": true},
        "external_actions_authorized": {"const": false}
      }
    }
  }
}
