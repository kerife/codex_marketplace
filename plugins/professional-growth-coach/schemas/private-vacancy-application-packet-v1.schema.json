{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/professional-growth-coach/private-vacancy-application-packet-v1.schema.json",
  "title": "Private Vacancy Application Packet v1",
  "type": "object",
  "required": [
    "schema_version",
    "locale",
    "as_of_date",
    "target_binding",
    "readiness",
    "requirement_evidence",
    "unsupported_or_missing_claims",
    "draft_materials",
    "claim_review",
    "first_interview_prep_handoff",
    "tracking_proposal",
    "approval_boundary",
    "source_snapshot"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "private-vacancy-application-packet-v1"},
    "locale": {"enum": ["es", "en"]},
    "as_of_date": {"$ref": "#/$defs/date"},
    "target_binding": {
      "type": "object",
      "required": ["vacancy_id", "vacancy_title", "organization_label", "eligibility_state", "next_safe_action"],
      "additionalProperties": false,
      "properties": {
        "vacancy_id": {"$ref": "#/$defs/vacancy_id"},
        "vacancy_title": {"$ref": "#/$defs/bounded_text"},
        "organization_label": {"$ref": "#/$defs/bounded_text"},
        "eligibility_state": {"enum": ["insufficient_recurrence", "insufficient_gap_evidence", "learning_not_applicable"]},
        "next_safe_action": {"const": "prepare_private_vacancy_packet"}
      }
    },
    "readiness": {
      "type": "object",
      "required": ["state", "headline", "rationale", "blocking_requirement_ids", "blocking_gate_tokens", "revision_claim_ids", "manual_review_required", "external_action_authorized"],
      "additionalProperties": false,
      "properties": {
        "state": {"enum": ["revise_first", "ready_for_manual_authorization", "stop"]},
        "headline": {"$ref": "#/$defs/bounded_text"},
        "rationale": {"$ref": "#/$defs/bounded_text"},
        "blocking_requirement_ids": {"type": "array", "minItems": 0, "maxItems": 30, "uniqueItems": true, "items": {"$ref": "#/$defs/requirement_id"}},
        "blocking_gate_tokens": {"type": "array", "minItems": 0, "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/gate_token"}},
        "revision_claim_ids": {"type": "array", "minItems": 0, "maxItems": 60, "uniqueItems": true, "items": {"$ref": "#/$defs/claim_id"}},
        "manual_review_required": {"const": true},
        "external_action_authorized": {"const": false}
      }
    },
    "requirement_evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["requirement_id", "signal", "priority", "fact_ids", "coverage", "confidence"],
        "additionalProperties": false,
        "properties": {
          "requirement_id": {"$ref": "#/$defs/requirement_id"},
          "signal": {"type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-z][a-z0-9_]{1,63}$"},
          "priority": {"enum": ["required", "preferred", "contextual"]},
          "fact_ids": {"type": "array", "minItems": 0, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/fact_id"}},
          "coverage": {"enum": ["supported", "partial", "missing", "conflicting", "review_required"]},
          "confidence": {"enum": ["high", "medium", "low", "unknown"]}
        }
      }
    },
    "unsupported_or_missing_claims": {
      "type": "array",
      "minItems": 0,
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["requirement_id", "signal", "reason", "next_private_step"],
        "additionalProperties": false,
        "properties": {
          "requirement_id": {"$ref": "#/$defs/requirement_id"},
          "signal": {"type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-z][a-z0-9_]{1,63}$"},
          "reason": {"enum": ["missing_evidence", "conflicting_evidence", "review_required"]},
          "next_private_step": {"$ref": "#/$defs/bounded_text"}
        }
      }
    },
    "draft_materials": {
      "type": "object",
      "required": ["cv_bullets", "recruiter_summary", "message_angle"],
      "additionalProperties": false,
      "properties": {
        "cv_bullets": {"type": "array", "minItems": 0, "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/cv_draft"}},
        "recruiter_summary": {"type": "array", "minItems": 0, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/recruiter_draft"}},
        "message_angle": {"type": "array", "minItems": 0, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/message_draft"}}
      }
    },
    "claim_review": {
      "type": "array",
      "minItems": 0,
      "maxItems": 60,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["claim_id", "draft_id", "fact_ids", "requirement_ids", "decision", "confidence", "review_note"],
        "additionalProperties": false,
        "properties": {
          "claim_id": {"$ref": "#/$defs/claim_id"},
          "draft_id": {"oneOf": [{"$ref": "#/$defs/draft_id"}, {"type": "null"}]},
          "fact_ids": {"type": "array", "minItems": 0, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/fact_id"}},
          "requirement_ids": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/requirement_id"}},
          "decision": {"enum": ["use", "revise", "omit"]},
          "confidence": {"enum": ["high", "medium", "low", "unknown"]},
          "review_note": {"$ref": "#/$defs/bounded_text"}
        }
      }
    },
    "first_interview_prep_handoff": {
      "type": "object",
      "required": ["state", "interview_stage", "vacancy_id", "requirement_ids", "fact_ids", "next_private_step"],
      "additionalProperties": false,
      "properties": {
        "state": {"enum": ["available", "suppressed"]},
        "interview_stage": {"const": "unknown"},
        "vacancy_id": {"$ref": "#/$defs/vacancy_id"},
        "requirement_ids": {"type": "array", "minItems": 0, "maxItems": 30, "uniqueItems": true, "items": {"$ref": "#/$defs/requirement_id"}},
        "fact_ids": {"type": "array", "minItems": 0, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/fact_id"}},
        "next_private_step": {"$ref": "#/$defs/bounded_text"}
      }
    },
    "tracking_proposal": {
      "type": "object",
      "required": ["record_state", "event_kind", "vacancy_id", "outcome_state", "manual_reentry_required", "auto_start"],
      "additionalProperties": false,
      "properties": {
        "record_state": {"enum": ["proposed", "not_proposed"]},
        "event_kind": {"enum": ["application_packet_drafted", "none"]},
        "vacancy_id": {"$ref": "#/$defs/vacancy_id"},
        "outcome_state": {"enum": ["draft_only", "not_started"]},
        "manual_reentry_required": {"const": true},
        "auto_start": {"const": false}
      }
    },
    "approval_boundary": {
      "type": "object",
      "required": ["artifact_state", "allowed_next_step", "prohibited_actions", "authorization_required"],
      "additionalProperties": false,
      "properties": {
        "artifact_state": {"const": "private_draft"},
        "allowed_next_step": {"const": "manual_private_review"},
        "prohibited_actions": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "uniqueItems": true,
          "items": {"enum": ["external_edit", "upload", "export", "share", "submit", "publish", "message", "connect", "apply", "schedule", "calendar_create", "purchase", "enroll"]}
        },
        "authorization_required": {"const": true}
      }
    },
    "source_snapshot": {
      "type": "object",
      "required": ["eligibility", "target_vacancy_research", "candidate_fact_matrix", "aggregate"],
      "additionalProperties": false,
      "properties": {
        "eligibility": {"type": "string", "pattern": "^snap-next-action-eligibility-v1-sha256-[0-9a-f]{64}$"},
        "target_vacancy_research": {"type": "string", "pattern": "^snap-market-sha256-[0-9a-f]{64}$"},
        "candidate_fact_matrix": {"type": "string", "pattern": "^snap-candidate-fact-matrix-v1-sha256-[0-9a-f]{64}$"},
        "aggregate": {"type": "string", "pattern": "^snap-private-vacancy-packet-sources-v1-sha256-[0-9a-f]{64}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"readiness": {"properties": {"state": {"const": "stop"}}}}},
      "then": {
        "properties": {
          "readiness": {"properties": {"blocking_gate_tokens": {"minItems": 1}, "revision_claim_ids": {"maxItems": 0}}},
          "draft_materials": {"properties": {"cv_bullets": {"maxItems": 0}, "recruiter_summary": {"maxItems": 0}, "message_angle": {"maxItems": 0}}},
          "claim_review": {"maxItems": 0},
          "first_interview_prep_handoff": {"properties": {"state": {"const": "suppressed"}, "requirement_ids": {"maxItems": 0}, "fact_ids": {"maxItems": 0}}},
          "tracking_proposal": {"properties": {"record_state": {"const": "not_proposed"}, "event_kind": {"const": "none"}, "outcome_state": {"const": "not_started"}}}
        }
      }
    },
    {
      "if": {"properties": {"readiness": {"properties": {"state": {"const": "ready_for_manual_authorization"}}}}},
      "then": {
        "properties": {
          "readiness": {"properties": {"blocking_requirement_ids": {"maxItems": 0}, "blocking_gate_tokens": {"maxItems": 0}, "revision_claim_ids": {"maxItems": 0}}},
          "first_interview_prep_handoff": {"properties": {"state": {"const": "available"}}}
        }
      }
    },
    {
      "if": {"properties": {"readiness": {"properties": {"state": {"const": "revise_first"}}}}},
      "then": {"properties": {"readiness": {"properties": {"blocking_gate_tokens": {"maxItems": 0}}}}}
    }
  ],
  "$defs": {
    "date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "bounded_text": {"type": "string", "minLength": 1, "maxLength": 500},
    "vacancy_id": {"type": "string", "pattern": "^V-[0-9]{3}$"},
    "requirement_id": {"type": "string", "pattern": "^V-[0-9]{3}-R-[0-9]{2}$"},
    "fact_id": {"type": "string", "pattern": "^F-[0-9]{3}$"},
    "claim_id": {"type": "string", "pattern": "^C-[0-9]{3}$"},
    "draft_id": {"type": "string", "pattern": "^D-(?:CV|RS|MA)-[0-9]{3}$"},
    "gate_token": {"enum": ["work_authorization", "country_geography", "work_arrangement", "language", "seniority", "experience_floor", "employment_arrangement"]},
    "evidence_state": {"enum": ["verified", "candidate_reported"]},
    "cv_draft": {
      "type": "object",
      "required": ["draft_id", "text", "fact_ids", "requirement_ids", "evidence_state"],
      "additionalProperties": false,
      "properties": {
        "draft_id": {"type": "string", "pattern": "^D-CV-[0-9]{3}$"},
        "text": {"type": "string", "minLength": 1, "maxLength": 800},
        "fact_ids": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/fact_id"}},
        "requirement_ids": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/requirement_id"}},
        "evidence_state": {"$ref": "#/$defs/evidence_state"}
      }
    },
    "recruiter_draft": {
      "type": "object",
      "required": ["draft_id", "text", "fact_ids", "requirement_ids", "evidence_state"],
      "additionalProperties": false,
      "properties": {
        "draft_id": {"type": "string", "pattern": "^D-RS-[0-9]{3}$"},
        "text": {"type": "string", "minLength": 1, "maxLength": 3200},
        "fact_ids": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/fact_id"}},
        "requirement_ids": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/requirement_id"}},
        "evidence_state": {"$ref": "#/$defs/evidence_state"}
      }
    },
    "message_draft": {
      "type": "object",
      "required": ["draft_id", "text", "fact_ids", "requirement_ids", "evidence_state"],
      "additionalProperties": false,
      "properties": {
        "draft_id": {"type": "string", "pattern": "^D-MA-[0-9]{3}$"},
        "text": {"type": "string", "minLength": 1, "maxLength": 800},
        "fact_ids": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/fact_id"}},
        "requirement_ids": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/requirement_id"}},
        "evidence_state": {"$ref": "#/$defs/evidence_state"}
      }
    }
  }
}
